  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: upgrade-insecure-requests; default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://cdn.galla.im https://bidqauputnhkqepvdzrr.supabase.co https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://videodelivery.net; font-src 'self' data:; frame-src https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://iframe.cloudflarestream.com; connect-src 'self' https://bidqauputnhkqepvdzrr.supabase.co wss://bidqauputnhkqepvdzrr.supabase.co https://cdn.galla.im https://challenges.cloudflare.com https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://videodelivery.net https://upload.cloudflarestream.com; worker-src 'self' blob:; manifest-src 'self'

# HTML 문서는 항상 재검증(no-cache) — 버전(?v=)이 HTML 안에 있어 HTML이 캐시되면
# 자산 갱신이 반영되지 않음. no-cache로 항상 최신 HTML을 받게 함(변경 즉시 반영).
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# CSS/JS도 항상 재검증 — 배포 전파 레이스로 새 ?v= URL에 옛 내용이 캐시되면
# 기기가 4시간 동안 옛 코드를 계속 실행한다(실제로 겪음).
# ⚠️ max-age=0, must-revalidate 는 Cloudflare가 14400초로 클램프해 버려서 소용없다.
#    반드시 no-cache 를 써야 매 요청 재검증한다. 변경 없으면 304라 비용은 미미.
/css/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache

# 벤더 라이브러리는 바뀌지 않으므로 장기 캐시 유지(위 /js/* 보다 뒤에 둬야 우선)
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 민감 페이지는 캐시 금지(설정/계정/인증)
/settings.html
  Cache-Control: no-store
/account-edit.html
  Cache-Control: no-store
/auth/*
  Cache-Control: no-store
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin-login.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# HTML 문서는 항상 재검증(no-cache) — 버전(?v=)이 HTML 안에 있어 HTML이 캐시되면
# 자산 갱신이 반영되지 않음. no-cache로 항상 최신 HTML을 받게 함(변경 즉시 반영).
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# CSS/JS도 항상 재검증(no-cache) — 배포 전파 레이스로 새 ?v= URL에 옛 내용이
# 캐시되어 기기가 계속 옛 코드를 보는 문제를 근절. 변경 없으면 304라 비용은 미미.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# 벤더 라이브러리는 바뀌지 않으므로 장기 캐시 유지(위 /js/* 보다 뒤에 둬야 우선)
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 민감 페이지는 캐시 금지(설정/계정/인증)
/settings.html
  Cache-Control: no-store
/account-edit.html
  Cache-Control: no-store
/auth/*
  Cache-Control: no-store
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin-login.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

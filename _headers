# HTML 문서는 항상 재검증(no-cache) — 버전(?v=)이 HTML 안에 있어 HTML이 캐시되면
# 자산 갱신이 반영되지 않음. no-cache로 항상 최신 HTML을 받게 함(변경 즉시 반영).
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# CSS/JS 재검증.
# ⚠️ 여기서 no-cache 를 쓰면 Cloudflare가 값을 통째로 버리고 기본 max-age=14400 을
#    씌워버린다(재검증조차 안 함 → 더 나쁨). 검증됨 2026-07-14.
#    max-age=0 도 존(Browser Cache TTL 4시간)에 클램프되지만 must-revalidate 는 살아남는다.
# ➜ 근본 해결은 Cloudflare 존 설정의 Browser Cache TTL 을
#    "Respect Existing Headers" 로 바꾸는 것.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# 벤더 라이브러리는 바뀌지 않으므로 장기 캐시 유지(위 /js/* 보다 뒤에 둬야 우선)
/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 민감 페이지는 캐시 금지(설정/계정/인증)
/settings.html
  Cache-Control: no-store
/account-edit.html
  Cache-Control: no-store
/auth/*
  Cache-Control: no-store
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin-login.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

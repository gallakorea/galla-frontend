# Cloudflare Pages 보안 헤더 (전 경로)
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # ⚠️ microphone/camera를 ()로 막으면 갈라 자신도 못 쓴다 — 브라우저가 권한 팝업조차
  #    띄우지 않고 즉시 NotAllowedError를 던지고, 크롬 사이트 설정엔 흔적도 안 남는다.
  #    (삐삐 녹음·음성 메시지·육성톡·면상톡이 전부 이 한 줄로 죽어 있었다)
  #    self만 허용 = 우리 페이지는 쓰고, 삽입된 외부 iframe은 못 쓰게 하는 올바른 설정.
  Permissions-Policy: geolocation=(), camera=(self), microphone=(self), payment=(), usb=(), magnetometer=(), gyroscope=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  Content-Security-Policy: upgrade-insecure-requests; default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://cdn.galla.im https://bidqauputnhkqepvdzrr.supabase.co https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://videodelivery.net; font-src 'self' data:; frame-src https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://iframe.cloudflarestream.com; connect-src 'self' https://bidqauputnhkqepvdzrr.supabase.co wss://bidqauputnhkqepvdzrr.supabase.co https://cdn.galla.im https://challenges.cloudflare.com https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://videodelivery.net https://upload.cloudflarestream.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; worker-src 'self' blob:; manifest-src 'self'

# 서비스워커·오프라인 셸 — 항상 재검증해 새 SW가 즉시 전파되게(no-cache).
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/offline.html
  Cache-Control: no-cache

# HTML 문서는 항상 재검증(no-cache) — 버전(?v=)이 HTML 안에 있어 HTML이 캐시되면
# 자산 갱신이 반영되지 않음. no-cache로 항상 최신 HTML을 받게 함(변경 즉시 반영).
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# 우리 코드(CSS/JS)는 항상 재검증 — 바뀌지 않았으면 304라 비용은 미미하다.
# ⚠️ 여기서 no-cache 를 쓰면 Cloudflare가 값을 통째로 버리고 기본 max-age 를
#    씌워버린다(재검증조차 안 함 → 더 나쁨). 반드시 max-age=0, must-revalidate.
# 존 설정 Browser Cache TTL = "Respect Existing Headers" 여야 이 값이 지켜진다
#    (4 hours 로 두면 클램프돼서 옛 코드가 4시간 살아남는다). 2026-07-14 적용됨.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# 벤더 라이브러리는 바뀌지 않으므로 장기 캐시.
# ⚠️ /js/vendor/ 에 두면 위 /js/* 규칙과 헤더가 합쳐져(둘 다 매치) 앞의 max-age=0 이
#    이겨버린다. 그래서 /js/ 밖으로 뺐다.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 민감 페이지는 캐시 금지(설정/계정/인증)
/settings.html
  Cache-Control: no-store
/account-edit.html
  Cache-Control: no-store
/auth/*
  Cache-Control: no-store
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin-login.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# 토스페이스 원본(12MB) — 한 번 받으면 계속 쓰도록 장기 캐시. 라이선스상 서브셋 불가.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

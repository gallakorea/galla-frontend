# Cloudflare Pages 보안 헤더 (전 경로)
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # ⚠️ microphone/camera를 ()로 막으면 갈라 자신도 못 쓴다 — 브라우저가 권한 팝업조차
  #    띄우지 않고 즉시 NotAllowedError를 던지고, 크롬 사이트 설정엔 흔적도 안 남는다.
  #    (삐삐 녹음·음성 메시지·육성톡·면상톡이 전부 이 한 줄로 죽어 있었다)
  #    self만 허용 = 우리 페이지는 쓰고, 삽입된 외부 iframe은 못 쓰게 하는 올바른 설정.
  Permissions-Policy: geolocation=(), camera=(self), microphone=(self), payment=(), usb=(), magnetometer=(), gyroscope=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Permitted-Cross-Domain-Policies: none
  # 🖼 connect-src 에 *.r2.cloudflarestorage.com 필수 —
  #    미디어 업로드는 브라우저가 R2 프리사인 URL로 직접 PUT 한다.
  #    Stream→R2 이관(2026-08) 때 업로드 대상이 바뀌었는데 여기를 안 고쳐서
  #    운영 웹에서 사진·영상 첨부가 통째로 죽어 있었다(콘솔에만 CSP 위반이 뜨고
  #    화면은 '표지 1/10'까지 정상으로 보여서 알아채기 어려웠다).
  #    cdn.galla.im 은 '읽기'용이라 업로드를 대신 못 한다 — 둘 다 있어야 한다.
  Content-Security-Policy: upgrade-insecure-requests; default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://cdn.galla.im https://bidqauputnhkqepvdzrr.supabase.co https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://videodelivery.net; font-src 'self' data:; frame-src 'self' https://challenges.cloudflare.com https://www.youtube.com https://www.youtube-nocookie.com https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://iframe.cloudflarestream.com; connect-src 'self' https://*.agora.io https://cloudflareinsights.com https://static.cloudflareinsights.com wss://*.agora.io https://*.sd-rtn.com wss://*.sd-rtn.com https://bidqauputnhkqepvdzrr.supabase.co wss://bidqauputnhkqepvdzrr.supabase.co https://cdn.galla.im https://*.r2.cloudflarestorage.com https://challenges.cloudflare.com https://customer-g7dnvj6akfr55r4w.cloudflarestream.com https://videodelivery.net https://upload.cloudflarestream.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; worker-src 'self' blob:; manifest-src 'self'

# 🎬 유튜브 프록시 재생 페이지(yt.html → /yt) — 네이티브 앱(capacitor://localhost)이
#    자기 도메인 임베드를 이 iframe 안에서 재생한다. 전역 X-Frame-Options:SAMEORIGIN /
#    frame-ancestors 'self' 는 이 프레이밍을 막으므로(검은 화면) 이 경로만 앱 스킴을 허용.
#    (CSP frame-ancestors 가 있으면 XFO보다 우선되지만, 구현 편차 방지로 XFO도 무력화)
/yt
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' capacitor: ionic: http://localhost https://localhost; script-src 'self' 'unsafe-inline' https://www.youtube.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://www.youtube.com; font-src 'self' data:
/yt.html
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' capacitor: ionic: http://localhost https://localhost; script-src 'self' 'unsafe-inline' https://www.youtube.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' https://www.youtube.com; font-src 'self' data:

# 버전 감시 파일 — 셸이 폴링해 새 배포를 감지(앱 웹뷰 자동 리로드). 절대 캐시 금지.
/version.txt
  Cache-Control: no-store
  Content-Type: text/plain

# 서비스워커·오프라인 셸 — 항상 재검증해 새 SW가 즉시 전파되게(no-cache).
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/offline.html
  Cache-Control: no-cache

# iOS Associated Domains — 패스키(webcredentials)용. Apple이 이 파일로 앱↔galla.im 연결 검증.
# 확장자 없는 파일이라 Content-Type을 명시(application/json 권장), 리다이렉트 없이 200이어야 함.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: no-cache

# Android Digital Asset Links — 패스키(get_login_creds)용. 앱 패키지 im.galla.app + 서명 SHA-256.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-cache

# HTML 문서는 항상 재검증(no-cache) — 버전(?v=)이 HTML 안에 있어 HTML이 캐시되면
# 자산 갱신이 반영되지 않음. no-cache로 항상 최신 HTML을 받게 함(변경 즉시 반영).
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache

# 우리 코드(CSS/JS) — 장기 캐시 + immutable (2026-07-21 성능 개편).
# 모든 참조가 ?v=NNNNNN 버전드라 배포 때 URL이 바뀐다 → 재검증 자체가 불필요.
# 이전의 max-age=0(매 방문 47개 304 왕복)이 재방문 체감을 잡아먹고 있었다.
# ⚠️ 전제: 코드 참조는 반드시 ?v= 를 달 것(무버전 참조는 영영 낡는다) —
#    자동 범프가 붙여주며, 동적 로드는 loadScript()가 v를 상속한다.
# ⚠️ 존 Browser Cache TTL = "Respect Existing Headers" 유지(2026-07-14 설정).
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# 벤더 라이브러리는 바뀌지 않으므로 장기 캐시.
# ⚠️ /js/vendor/ 에 두면 위 /js/* 규칙과 헤더가 합쳐져(둘 다 매치) 앞의 max-age=0 이
#    이겨버린다. 그래서 /js/ 밖으로 뺐다.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 민감 페이지는 캐시 금지(설정/계정/인증)
/settings.html
  Cache-Control: no-store
/account-edit.html
  Cache-Control: no-store
/auth/*
  Cache-Control: no-store
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/admin-login.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# 토스페이스 원본(12MB) — 한 번 받으면 계속 쓰도록 장기 캐시. 라이선스상 서브셋 불가.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# 🏢 회사 소개 사이트(company.galla.im) 미디어 — 파일명이 바뀌지 않으므로 길게 캐시
/assets/company/*
  Cache-Control: public, max-age=31536000, immutable
